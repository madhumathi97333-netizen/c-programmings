#include <stdio.h>

int main() {
    int A1, A2, A3, B1, B2, B3;
    scanf("%d %d %d %d %d %d", &A1, &A2, &A3, &B1, &B2, &B3);

    // Put Alice's and Bob's rolls into arrays
    int A[3] = {A1, A2, A3};
    int B[3] = {B1, B2, B3};

    // Sort Alice's rolls (simple bubble sort for 3 elements)
    for (int i = 0; i < 2; i++) {
        for (int j = 0; j < 2 - i; j++) {
            if (A[j] > A[j + 1]) {
                int temp = A[j];
                A[j] = A[j + 1];
                A[j + 1] = temp;
            }
        }
    }

    // Sort Bob's rolls
    for (int i = 0; i < 2; i++) {
        for (int j = 0; j < 2 - i; j++) {
            if (B[j] > B[j + 1]) {
                int temp = B[j];
                B[j] = B[j + 1];
                B[j + 1] = temp;
            }
        }
    }

    // Sum of highest two rolls is elements at indices 1 and 2
    int alice_score = A[1] + A[2];
    int bob_score   = B[1] + B[2];

    if (alice_score > bob_score) {
        printf("Alice");
    } else if (bob_score > alice_score) {
        printf("Bob");
    } else {
        printf("Tie");
    }

    return 0;
}
